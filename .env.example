# Supabase — projet lié = DEV (ocmtgjlkasrmwmcctlyk)
# Copier vers .env.local (gitignoré) et remplir. Ne jamais committer de secret.

NEXT_PUBLIC_SUPABASE_URL=https://ocmtgjlkasrmwmcctlyk.supabase.co

# Clé publishable (sb_publishable_…). Exposée au client, sans danger.
# Si le projet est en clés legacy, utiliser NEXT_PUBLIC_SUPABASE_ANON_KEY à la place.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Clé secret / service_role (sb_secret_…). SERVEUR UNIQUEMENT. Jamais exposée au client.
# Récupérer dans le dashboard Supabase > Project Settings > API keys.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Clé API Anthropic (Claude). SERVEUR UNIQUEMENT — jamais de préfixe NEXT_PUBLIC_.
# Récupérer dans la console Anthropic. Sert à la rédaction IA (Phase 5).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
