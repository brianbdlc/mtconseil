# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/

# playwright-cli artifacts
.playwright-cli/

# Fichiers de verrouillage temporaires Word/Office
~$*
~$*.docx
assets/~$*

# Rapport de référence : peut contenir des données client (loi 25) — jamais versionné.
# Seul assets/report-template.docx (gabarit nettoyé) est suivi.
assets/modele.docx
# Idem : modèle + captures de fiches réelles (données client) utilisés pour calibrer
# l'export, jamais versionnés.
docs/reference/

# Playwright
test-results/
playwright-report/
blob-report/
tests/e2e/.auth/

# docx render verification output
scripts/out/
